{
  "name": "tritonai-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "crawl": "node scripts/crawl.mjs",
    "extract:newsletters": "node scripts/extract-newsletters.mjs",
    "sync:ai-news": "node scripts/sync-ai-news.mjs",
    "check:ai-news": "node scripts/sync-ai-news.mjs --check",
    "check:newsletter-links": "node scripts/check-newsletter-links.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "sync:decorator": "node scripts/sync-decorator.mjs",
    "check:decorator": "node scripts/sync-decorator.mjs --check",
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "chrome:check": "node scripts/chrome-contract.mjs --check",
    "chrome:accept": "node scripts/chrome-contract.mjs --accept",
    "chrome:explain": "node scripts/chrome-contract.mjs --explain",
    "ux:audit": "node scripts/ux-agent/run.mjs --mode audit-only",
    "ux:review": "node scripts/ux-agent/run.mjs --mode audit-and-draft",
    "ux:verify": "node scripts/ux-agent/verify.mjs",
    "test:a11y": "node scripts/accessibility-check.mjs",
    "test:ux": "node --test test/ux-agent/*.test.mjs",
    "test:language": "node scripts/language-check.mjs",
    "test:ai-news": "node --test test/sync-ai-news.test.mjs test/newsletter-links.test.mjs",
    "test:skills-release": "node --test test/skills-release-gate.test.mjs",
    "test:models": "node --test test/model-catalog.test.mjs",
    "test:chrome": "node --test test/chrome-contract.test.mjs test/chrome-styling.test.mjs",
    "test:cascade-release": "node --test test/cascade-release-workflow.test.mjs",
    "test": "npm run test:ux && npm run test:ai-news && npm run test:media && npm run test:skills-release && npm run test:models && npm run test:chrome && npm run test:cascade-release && npm run test:indexing && npm run build && npm run validate && npm run test:a11y && npm run test:language",
    "sync:models": "node scripts/sync-model-hub.mjs",
    "check:models": "node scripts/sync-model-hub.mjs --check",
    "sync:media": "node scripts/sync-media-coverage.mjs",
    "check:media": "node scripts/sync-media-coverage.mjs --check",
    "render:media": "node --input-type=module -e \"import{loadArticles,renderAndWriteAll}from'./scripts/lib/media-articles.mjs';await renderAndWriteAll(await loadArticles())\"",
    "test:media": "node --test test/sync-media-coverage.test.mjs",
    "test:indexing": "node --test test/playground-indexing.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "lighthouse": "^12.8.2",
    "playwright": "^1.55.0"
  }
}
